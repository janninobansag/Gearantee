@model ResetPasswordViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Reset Password";
}

<div class="login-page forgot-password-page">
    <aside class="login-story" aria-label="Gearantee overview">
        <div class="login-story-mark" aria-hidden="true">
            <img class="login-story-logo" src="~/img/LOGO 1.png" alt="" />
        </div>
        <div class="login-story-content">
            <div class="login-story-copy">
                <h1>Reserve it,<br />collect it,<br />return it.</h1>
                <p>One record for every laptop, projector, camera, speaker and lab tool the campus lends out - from request to condition check.</p>
            </div>

            <div class="login-stats" aria-label="System summary">
                <div class="login-stat">
                    <strong>248</strong>
                    <span>Items tracked</span>
                </div>
                <div class="login-stat">
                    <strong>5</strong>
                    <span>Categories</span>
                </div>
                <div class="login-stat">
                    <strong>3</strong>
                    <span>Roles</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="login-form-shell">
        <section class="login-panel forgot-panel" aria-labelledby="reset-password-heading">
            <a class="forgot-back" asp-controller="Account" asp-action="Login">Back to sign in</a>
            <h2 id="reset-password-heading">Reset password</h2>
            <p class="login-intro forgot-intro">Choose a new password for your Gearantee account.</p>

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="login-field">
                    <label asp-for="Password">New password</label>
                    <input asp-for="Password" class="login-input" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="login-input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="login-field-error"></span>
                </div>

                <button class="login-submit forgot-submit" type="submit">Reset password</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
