@model ForgotPasswordViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Check Your Inbox";
}

<div class="login-page forgot-password-page">
    <aside class="login-story" aria-label="Gearantee overview">
        <div class="login-story-mark" aria-hidden="true">
            <img class="login-story-logo" src="~/img/LOGO 1.png" alt="" />
        </div>
        <div class="login-story-content">
            <div class="login-story-copy">
                <h1>Reserve it,<br />collect it,<br />return it.</h1>
                <p>One record for every laptop, projector, camera, speaker and lab tool the campus lends out — from request to condition check.</p>
            </div>

            <div class="login-stats" aria-label="System summary">
                <div class="login-stat">
                    <strong>248</strong>
                    <span>Items tracked</span>
                </div>
                <div class="login-stat">
                    <strong>5</strong>
                    <span>Categories</span>
                </div>
                <div class="login-stat">
                    <strong>3</strong>
                    <span>Roles</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="login-form-shell">
        <section class="login-panel forgot-check-panel" aria-labelledby="forgot-check-heading">
            <div class="forgot-inbox-icon" aria-hidden="true">
                <svg viewBox="0 0 17 17" role="presentation">
                    <rect x="1.5" y="3.2" width="14" height="10.6"></rect>
                    <path d="M2 4.1 8.5 9l6.5-4.9"></path>
                </svg>
            </div>

            <h2 id="forgot-check-heading">Check your inbox</h2>
            <p class="forgot-check-copy">
                If an active account exists for this address, a reset link is on its way from
                <strong>noreply@school.edu</strong>.
            </p>
            <p class="forgot-check-expiry">The link expires in 60 minutes and can be used once.</p>

            <div class="forgot-check-actions">
                <a class="forgot-check-back" asp-controller="Account" asp-action="Login">Back to sign in</a>
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <input asp-for="Email" type="hidden" />
                    <button class="forgot-check-resend" type="submit">Resend</button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
