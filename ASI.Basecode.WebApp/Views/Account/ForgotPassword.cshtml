@model ForgotPasswordViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page forgot-password-page">
    <aside class="login-story" aria-label="Gearantee overview">
        <div class="login-story-mark" aria-hidden="true">
            <img class="login-story-logo" src="~/img/LOGO 1.png" alt="" />
        </div>
        <div class="login-story-content">
            <div class="login-story-copy">
                <h1>Reserve it,<br />collect it,<br />return it.</h1>
                <p>One record for every laptop, projector, camera, speaker and lab tool the campus lends out — from request to condition check.</p>
            </div>

            <div class="login-stats" aria-label="System summary">
                <div class="login-stat">
                    <strong>248</strong>
                    <span>Items tracked</span>
                </div>
                <div class="login-stat">
                    <strong>5</strong>
                    <span>Categories</span>
                </div>
                <div class="login-stat">
                    <strong>3</strong>
                    <span>Roles</span>
                </div>
            </div>
        </div>
    </aside>

    <div class="login-form-shell">
        <section class="login-panel forgot-panel" aria-labelledby="forgot-password-heading">
            <a class="forgot-back" asp-controller="Account" asp-action="Login">← Back to sign in</a>
            <h2 id="forgot-password-heading">Forgot password</h2>
            <p class="login-intro forgot-intro">We will send a six-digit verification code to your registered school address.</p>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <p class="forgot-message" role="status">@successMessage</p>
            }

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Email">Registered email</label>
                    <input asp-for="Email" class="login-input" type="email"
                           autocomplete="email"
                           placeholder="you@school.edu" />
                    <span asp-validation-for="Email" class="login-field-error"></span>
                </div>

                <button class="login-submit forgot-submit" type="submit">Send verification code</button>
            </form>

            <p class="forgot-note">For your protection, the same confirmation is shown whether or not the address is registered.</p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
